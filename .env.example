# Backend only. Use a dedicated database. Never prefix secrets with VITE_.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/aeropulse
# Supabase: use the session pooler (port 5432), add ?sslmode=require.
DATA_MODE=demo
CORS_ORIGINS=http://localhost:5173
# Optional: require this bearer token for mutation endpoints outside public demo.
ADMIN_TOKEN=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Leave empty for same-origin Vercel deployment.
VITE_API_URL=
# Optional scheduled worker authentication (Vercel Cron Authorization bearer).
CRON_SECRET=
